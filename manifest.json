{
  "manifest_version": 3,
  "name": "SOCKS5 Domain Router",
  "version": "1.0.0",
  "description": "Route specific domains through a SOCKS5 proxy while leaving the rest of your traffic direct.",
  "permissions": ["proxy", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SOCKS5 Domain Router",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
