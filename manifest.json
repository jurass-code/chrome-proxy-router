{
  "manifest_version": 3,
  "name": "Domain Proxy Router",
  "version": "1.1.0",
  "description": "Route specific domains through a SOCKS5 or HTTP proxy (with optional login/password) while leaving the rest of your traffic direct.",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Domain Proxy Router",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
